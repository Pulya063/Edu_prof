# Copy to .env and fill in. Never commit real values.

# --- App ---
APP_ENV=development
SECRET_KEY=
FRONTEND_URL=http://localhost:3221
LOG_LEVEL=INFO
LOG_FILE=
AUTH_COOKIE_SAMESITE=Lax

# --- Auth tokens ---
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database / cache / queue ---
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Google OAuth (button is disabled when empty) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${FRONTEND_URL}/api/auth/callback/google; must be listed in Google Console.
OAUTH_REDIRECT_URI=
# Defaults to ${FRONTEND_URL}/workspace/overview.
OAUTH_SUCCESS_URL=

# --- Stripe (checkout reports "not configured" when empty) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price IDs from the Stripe dashboard (price_...). A plan without a Price ID is not on sale.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_TEAMS_MONTHLY=
STRIPE_PRICE_TEAMS_YEARLY=

# --- AI review (advisory only, never a source of numbers) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEP_AGENT_MODEL=

# --- Data providers ---
COLLEGE_SCORECARD_API_KEY=
WATCHED_SCORECARD_IDS=
ONET_USERNAME=
ONET_PASSWORD=

# --- DreamWork (shared service account) ---
DREAMWORK_API_URL=
DREAMWORK_USERNAME=
DREAMWORK_PASSWORD=

# --- Mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Local-only experiments ---
CHROMA_PERSIST_DIR=

# Frontend feature flags (public, not secrets)
# NEXT_PUBLIC_FENCE_SUPPORT_EMAIL=
# Show the Resources panel on /workspace/overview (hidden by default)
# NEXT_PUBLIC_FENCE_DASHBOARD_RESOURCES=false

# Contact (URL or e-mail) placed in the crawler user agent; Wikimedia rejects bots without one.
CRAWLER_CONTACT=
